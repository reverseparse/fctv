PORT=7070
HOST=0.0.0.0

# ---- Deploy / security ----
NODE_ENV=production
# Public origin of the addon (no path). Required in production: used to build stream URLs.
PUBLIC_BASE_URL=https://addon.example.com
# Optional but recommended: addon is served only under /<ACCESS_KEY>/ (16-128 chars [A-Za-z0-9_-]).
# Install in Stremio with https://addon.example.com/<ACCESS_KEY>/manifest.json
ACCESS_KEY=
# Secret used to sign proxy URLs (openssl rand -hex 32). Keep it stable across restarts.
HLS_SECRET=
# Enables /debug/* when set (send as 'Authorization: Bearer <token>'). Leave empty to disable.
ADMIN_TOKEN=
# Number of reverse-proxy hops in front of the app (needed for correct per-IP rate limiting).
TRUST_PROXY=1
# Optional: use an external EasyProxy (https://github.com/realbestia1/EasyProxy) instead of the built-in proxy.
# Origin only, no path. Leave empty to keep the internal /hls + /seg proxy.
EASYPROXY_URL=
# Value of EasyProxy's API_PASSWORD (sent as api_password in the stream URL). Leave empty if it has none.
EASYPROXY_PASSWORD=
# true = streams only via EasyProxy: built-in /hls + /seg proxy disabled, and users must enter their own
# EasyProxy on the landing page (unless EASYPROXY_URL above is set server-wide).
EASYPROXY_REQUIRED=false
RATE_LIMIT_API_MAX=120
RATE_LIMIT_PROXY_MAX=900
PROXY_MAX_CONCURRENCY=40

# Firebase configuration discovered from the official FCTV77 APK.
FCTV77_FIREBASE_PROJECT_ID=rbapp-672ea
FCTV77_FIRESTORE_DOCUMENT=foth_APP_KVS/params_production
FCTV77_FIRESTORE_DATABASE=(default)

# Refresh remote domains every 5 minutes; timeout applies to Firestore and host checks.
FCTV77_CONFIG_REFRESH_MS=300000
FCTV77_CONFIG_TIMEOUT_MS=8000

# Fallbacks used only if Firebase cannot be reached or does not provide a value.
FCTV77_DATA_API_BASE_URL=https://apis-data10.tcdru136ovur.ru
FCTV77_LIVE_API_BASE_URL=https://apis-live.ta2mnt200stayr2.cfd
FCTV77_DATA_API_EU_BASE_URL=
FCTV77_LIVE_API_EU_BASE_URL=

# APK-derived catalog parameters.
FCTV77_LIVE_CODE=100
# PBLanguage.L_IT = 8 in the APK protobuf enum.
FCTV77_LANGUAGE=8
# Parallel detail resolution with a small inter-request pause.
FCTV77_REQUEST_DELAY_MS=100
FCTV77_DETAIL_CONCURRENCY=6
FCTV77_CATALOG_TIMEOUT_MS=12000
FCTV77_CATALOG_CACHE_MS=120000
FCTV77_DETAIL_CACHE_MS=300000
FCTV77_STREAM_TIMEOUT_MS=12000
